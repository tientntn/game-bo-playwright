# Secret Google Authenticator CỐ ĐỊNH của tài khoản test (đã capture 1 lần, secret KHÔNG đổi qua
# các lần gọi generateOtp vì GenerateOtp chỉ đọc lại - xem SasEntityUserService.cs). Lưu ở đây để
# verifyOtpSession() trong fixtures.js dùng trực tiếp, KHÔNG cần gọi /auth/generateOtp mỗi lần nữa
# - tách test khỏi hành vi generateOtp trả secret vô điều kiện (nghi vấn lỗ hổng bảo mật đã trao đổi,
# nên fix phía backend không nên làm hỏng test). Nếu tài khoản bị reset 2FA (secret đổi), xoá dòng
# này đi - fixtures.js sẽ tự fallback gọi lại generateOtp để lấy secret mới, xong thì điền lại đây.

# tests/api/dangerous.spec.js - MẶC ĐỊNH TẮT (0). Chỉ đổi thành 1 khi THẬT SỰ muốn chạy các test
# rủi ro (rác vĩnh viễn / side-effect hệ thống ngoài thật) - xem comment đầu file dangerous.spec.js
# và KNOWN_ISSUES.md. Nhớ đổi lại về 0 sau khi chạy xong để không vô tình bật lại ở lần chạy sau.
RUN_DANGEROUS_TESTS=0

# Chỉ cần điền khi bật 3 test side-effect hệ thống ngoài (game_round/update-status,
# operator_request/retry, player/kick) - PHẢI là bản ghi THẬT do bạn tự chọn, không để trống rồi
# đoán đại vì mỗi endpoint này tác động thật, không thể khôi phục.
DANGEROUS_GAME_ROUND_IDS=1001
DANGEROUS_GAME_ROUND_STATUS=Completed
DANGEROUS_OPERATOR_REQUEST_ID=1001
DANGEROUS_PLAYER_ID=11718
DANGEROUS_PLAYER_AGENT_CODE=retkn
